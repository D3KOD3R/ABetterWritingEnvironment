{\fonttbl{\f0\fmodern\fcharset0\fprq2 Sitka Small;}{\f1\fmodern\fcharset0\fprq2 TimesNewRomanPSMT;}{\f2\fmodern\fcharset0\fprq2 TimesNewRomanPS-ItalicMT;}}
